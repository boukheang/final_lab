{
  "info": {
    "_postman_id": "c1d0f1a7-6b2e-4f4f-9c1d-cldf1na10001",
    "name": "CLD Final - Student Microservices",
    "description": "All requests go through the API Gateway on port 4000. Task 5 registers a student; Task 6 deletes that student.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Task 5 - Register Student (via Gateway)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Response has the registered student', function () {",
              "    pm.expect(body.student).to.be.an('object');",
              "    pm.expect(body.student.student_email).to.eql('sokha.chan@example.com');",
              "    pm.expect(body.student).to.not.have.property('student_password');",
              "});",
              "",
              "pm.environment.set('Student_id', body.student.Student_id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Student_id\": \"STU-2026-001\",\n  \"Student_name\": \"Sokha Chan\",\n  \"student_mobile\": \"+855 12 345 678\",\n  \"student_email\": \"sokha.chan@example.com\",\n  \"student_password\": \"Student@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        },
        "description": "Gateway route: POST /api/students -> Registration microservice POST /register."
      },
      "response": []
    },
    {
      "name": "Task 6 - Delete Student (via Gateway)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('Deleted the expected student', function () {",
              "    pm.expect(body.message).to.eql('Student deleted successfully');",
              "    pm.expect(body.student.Student_id).to.eql(pm.environment.get('Student_id'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{Student_id}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students", "{{Student_id}}"]
        },
        "description": "Gateway route: DELETE /api/students/:student_id -> Delete Student microservice DELETE /students/:student_id."
      },
      "response": []
    },
    {
      "name": "Health - Gateway + both microservices",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Gateway and both upstreams are healthy', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4000"
    },
    {
      "key": "Student_id",
      "value": "STU-2026-001"
    }
  ]
}
